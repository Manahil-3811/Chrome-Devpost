{
    "manifest_version":3,
    "name":"Tabby",
    "version":"1.0",
    "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "notifications"
  ],

  "action":{
    "default_popup":"popup.html",
    "defualt_icon":"icon.png"
  },
 "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "host_permissions": ["<all_urls>"]
}